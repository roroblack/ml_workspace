# ---- 백엔드 서버 ----
PORT=8080
NODE_ENV=development

# 내부 인증 (Streamlit/시뮬에서 x-api-key 헤더로 전송)
API_KEY=change-me-dev-key

# ---- 운영 DB (MySQL 8) ----
# 형식: mysql://user:pass@host:3306/churn_ops
MYSQL_URL=mysql://root:password@localhost:3306/churn_ops

# ---- 시뮬 로그 DB (Neon / Postgres) ----
# 풀링 엔드포인트 + SSL 필수
NEON_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ---- 실시간/위험등급 파라미터 ----
RISK_LOW=0.35
RISK_HIGH=0.65
PULL_INTERVAL_MS=5000
ENABLE_PULL_WORKER=false

# ---- 스키마/추천 ----
FEATURE_SCHEMA_VERSION=v2
# 추천 이벤트 가중 (view:cart:purchase)
REC_WEIGHT_VIEW=1
REC_WEIGHT_CART=3
REC_WEIGHT_PURCHASE=5

# ---- (여유 시) 결과 Neon push ----
ENABLE_NEON_PUSH=false
